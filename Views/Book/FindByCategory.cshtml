@model IEnumerable<BookStore.DataModels.Book>

@{
    ViewData["Title"] = "Books by Category";
}

<div class="container mt-5">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No books found in this category.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <a class="text-decoration-none text-dark" href="/Book/Details/@item.BookId">
                            <img src="@item.ImagePath" class="card-img-top" alt="@item.BookName" style="height: 250px; object-fit: cover;" onerror="this.src='/images/default-book.png'">

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.BookName</h5>
                                <p class="card-text mb-1"><strong>Author:</strong> @item.Author</p>
                                <p class="card-text mb-1"><strong>Provider:</strong> @item.Provider</p>
                                <p class="card-text text-primary fw-bold mt-auto">$@item.Price.ToString("0.00")</p>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
