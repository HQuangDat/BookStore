@model IEnumerable<BookStore.DataModels.Book>

@{
    ViewData["Title"] = "Books by Category";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["CategoryName"]</h1>
        <a asp-controller="Category" asp-action="List" class="btn btn-secondary">Back to Categories</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <p class="h4">No books found in this category.</p>
            <p>Check back later or explore other categories!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId" class="text-decoration-none text-dark">
                            <img src="@item.ImagePath" class="card-img-top" alt="@item.BookName" style="height: 300px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@item.BookName</h5>
                                <p class="card-text text-muted">by @item.Author</p>
                                <p class="card-text fw-bold text-danger mt-2">$@item.Price.ToString("0.00")</p>
                            </div>
                        </a>
                        <div class="card-footer bg-transparent border-0">
                            <form asp-controller="Cart" asp-action="Add" asp-route-id="@item.BookId" method="post">
                                @Html.AntiForgeryToken()
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-cart-plus me-2"></i>Add to Cart
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>