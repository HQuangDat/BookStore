@model BookStore.DataModels.Book
@if(User.IsInRole("Admin")){
    <section class="vh-100 d-flex align-items-center justify-content-center">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                    <div class="card bg-light text-black shadow-lg rounded-4">
                        <div class="card-body p-5">

                            <h2 class="fw-bold text-uppercase text-center mb-3">Add new book</h2>
                            <p class="text-muted text-center">Enter Book Information</p>

                            <form method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" asp-for="BookName" class="form-control" />
                                    <span asp-validation-for="BookName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Provider</label>
                                    <input type="text" asp-for="Provider" class="form-control" />
                                    <span asp-validation-for="Provider" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Price</label>
                                    <input type="number" asp-for="Price" class="form-control" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Author</label>
                                    <select asp-for="Author" asp-items="@ViewBag.Authors" class="form-control" />
                                    <span asp-validation-for="Author" class="text-danger"></span>
                                </div>

                                @* <div class="mb-3"> *@
                                @*     <label class="form-label">WareHouse</label> *@
                                @*     <select asp-for="Warehouse" asp-items="@ViewBag.Warehouses" class="form-control" /> *@
                                @*     <span asp-validation-for="Warehouse" class="text-danger"></span> *@
                                @* </div> *@

                                <div class="mb-3">
                                    <label class="form-label">Category</label>
                                    <select asp-for="Categories" asp-items="@ViewBag.Categories" class="form-control" />
                                    <span asp-validation-for="Categories" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Image</label>
                                    <input type="file" asp-for="ImagePath" class="form-control" />
                                    <span asp-validation-for="ImagePath" class="text-danger"></span>
                                </div>

                                <div class="mt-4">
                                    <button type="submit" class="btn btn-dark w-100 py-2">Submit</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <h1>You should not be here</h1>
}