@model IEnumerable<BookStore.DataModels.Book>

@{
    ViewData["Title"] = "List";
}

@if(User.Identity.IsAuthenticated)
{
    @if(User.IsInRole("Admin"))
    {
        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold">Manage Books</h2>
                <a asp-action="Add" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add New Book
                </a>
            </div>

            <!-- Optional: Search Bar -->
            <div class="mb-3">
                <input type="text" class="form-control" id="searchInput" placeholder="Search books..." onkeyup="searchTable()">
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Book Name</th>
                            <th>Provider</th>
                            <th>Price</th>
                            <th>Image</th>
                            <th>Author</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.Provider</td>
                                <td class="text-danger fw-bold">$@item.Price</td>
                                <td class="text-center">
                                    <img src="@item.ImagePath" alt="Book Cover" class="rounded" style="width: 50px; height: 75px;">
                                </td>
                                <td>@item.Author</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-info btn-sm text-white">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.BookId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this book?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <script>
            function searchTable() {
                let input = document.getElementById("searchInput").value.toLowerCase();
                let rows = document.querySelectorAll("tbody tr");

                rows.forEach(row => {
                    let text = row.innerText.toLowerCase();
                    row.style.display = text.includes(input) ? "" : "none";
                });
            }
        </script>
    }
}


