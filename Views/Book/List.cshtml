@using BookStore.Controllers
@model PaginatedList<BookStore.DataModels.Book>

@{
    ViewData["Title"] = "Manage Books";
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h2 class="mb-0">Manage Books</h2>
                <div class="d-flex gap-2">
                    <div class="w-75">
                        <input type="text" class="form-control" id="searchInput" placeholder="Search books..." onkeyup="searchTable()">
                    </div>
                    <a asp-action="Add" class="btn btn-light text-primary">
                        <i class="bi bi-plus-circle-fill me-2"></i>Add New Book
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><a asp-action="List" asp-route-sortOrder="@ViewData["SortByNameParam"]" class="text-decoration-none text-dark">Book Name</a></th>
                                <th><a asp-action="List" asp-route-sortOrder="@ViewData["SortByProviderParam"]" class="text-decoration-none text-dark">Provider</a></th>
                                <th><a asp-action="List" asp-route-sortOrder="@ViewData["SortByPriceParam"]" class="text-decoration-none text-dark">Price</a></th>
                                <th class="text-center">Image</th>
                                <th><a asp-action="List" asp-route-sortOrder="@ViewData["SortByAuthorParam"]" class="text-decoration-none text-dark">Author</a></th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.BookName</td>
                                    <td>@item.Provider</td>
                                    <td class="fw-bold text-danger">$@item.Price</td>
                                    <td class="text-center">
                                        <img src="@item.ImagePath" alt="Book Cover" class="rounded" style="width: 40px; height: 60px; object-fit: cover;">
                                    </td>
                                    <td>@item.Author</td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-outline-primary btn-sm" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-outline-info btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.BookId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this book?');" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="List" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-pageNumber="@(Model.PageIndex - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="List" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="List" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-pageNumber="@(Model.PageIndex + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <script>
        function searchTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }
    </script>
}
else
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center" role="alert">
            <h4>Access Denied</h4>
            <p>You do not have permission to view this page. Please log in as an administrator.</p>
        </div>
    </div>
}