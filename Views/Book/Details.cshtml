@model BookStore.DataModels.Book

@{
    ViewData["Title"] = "Details";
}

@if(User.Identity.IsAuthenticated)
{
    <h1>Details</h1>

    <div class="container mt-5">
        <div class="row">
            <!-- Book Image -->
            <div class="col-md-4 text-center">
                <img src="@Model.ImagePath" class="img-fluid rounded shadow-sm" alt="Book Cover" style="max-height: 400px;">
            </div>

            <!-- Book Details -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title fw-bold">@Model.BookName</h2>
                        <p class="text-muted">by @Model.Author</p>
                        <hr>

                        <p><strong>Provider:</strong> @Model.Provider</p>
                        <p class="h4 text-danger fw-bold">$@Model.Price</p>

                        <div class="mt-3">
                            @if(User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn btn-warning">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                            }
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Homepage
                            </a>

                            <form asp-controller="Cart" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model?.BookId" />
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}




