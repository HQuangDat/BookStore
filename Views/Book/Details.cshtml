@model BookStore.DataModels.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-lg">
                <img src="@Model.ImagePath" class="card-img-top" alt="Book Cover">
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h1 class="card-title">@Model.BookName</h1>
                    <p class="card-text text-muted">by @Model.Author</p>
                    <hr>
                    <p class="card-text"><strong>Provider:</strong> @Model.Provider</p>
                    <h2 class="card-text text-danger fw-bold mb-4">$@Model.Price</h2>

                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.BookId" />
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                    </form>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-pencil-square me-2"></i>Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="mt-4">
        <a asp-action="List" class="btn btn-secondary">Back to List</a>
    </div>
</div>