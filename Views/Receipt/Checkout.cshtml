@model List<Cart>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Receipt Card -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h3 class="mb-0"><i class="bi bi-receipt"></i> Order Summary</h3>
                </div>
                <div class="card-body">

                    <!-- User Information -->
                    <div class="mb-4 p-3 border rounded bg-light">
                        <h5 class="fw-bold"><i class="bi bi-person-circle"></i> Customer Information</h5>
                        <p class="mb-1"><strong>Email:</strong>@ViewBag.Email</p>
                        <p><strong>Address:</strong> @ViewBag.Address</p>
                    </div>

                    <!-- Order Summary Table -->
                    <table class="table table-borderless">
                        <thead class="border-bottom">
                            <tr>
                                <th>Book Name</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Book.BookName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end text-danger">$@item.Book.Price</td>
                                    <td class="text-end fw-bold">$@((item.Quantity * item.Book.Price).ToString("0.00"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Divider -->
                    <hr>

                    <!-- Total Section -->
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold">Total Amount:</h5>
                        <h4 class="text-danger fw-bold">$@Model.Sum(item => item.Quantity * item.Book.Price).ToString("0.00")</h4>
                    </div>
                </div>

                <!-- Confirm Purchase Button -->
                <div class="card-footer text-center bg-white">
                    <form asp-controller="Receipt" asp-action="ConfirmCheckout" method="post">
                        @Html.AntiForgeryToken()

                        @foreach (var item in Model)
                        {
                            <input type="hidden" name="CartItems[@Model.IndexOf(item)].BookId" value="@item.BookId" />
                            <input type="hidden" name="CartItems[@Model.IndexOf(item)].Quantity" value="@item.Quantity" />
                        }

                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-credit-card"></i> Confirm Purchase
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

