@model string

@{
    ViewData["Title"] = "Reset Password";
}

<section class="vh-100 d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-light text-black shadow-lg rounded-4">
                    <div class="card-body p-5">

                        <h2 class="fw-bold text-center mb-4">Reset Password</h2>
                        <p class="text-muted text-center">Enter your new password below</p>

                        <form method="post" action="/Account/ResetPassword">
                            <input type="hidden" name="token" value="@Model" />

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">New Password</label>
                                <input type="password" name="newPassword" id="newPassword" required class="form-control" placeholder="Enter new password" />
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success w-100 py-2">
                                    <i class="bi bi-shield-lock"></i> Reset Password
                                </button>
                            </div>
                        </form>

                        <div class="mt-4 text-center">
                            <a asp-action="Login" class="text-decoration-none text-muted">
                                <i class="bi bi-arrow-left"></i> Back to Login
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
