@model IEnumerable<BookStore.DataModels.Account>

@{
    ViewData["Title"] = "Account List";
}

@if (User.Identity.IsAuthenticated)
{
    <div class="container py-5">
        <h2 class="mb-4">Account List</h2>

        <!-- Search Bar -->
        <div class="mb-3">
            <input type="text" class="form-control" id="searchInput" placeholder="Search accounts..." onkeyup="searchTable()">
        </div>

        <!-- Account Table -->
        <div class="table-responsive">
            <table class="table table-hover table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Username</td>
                            <td class="text-center">
                                <span class="text-muted">••••••••</span>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info btn-sm text-white me-1">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.AccountId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm me-1" onclick="return confirm('Are you sure you want to delete this account?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                                <form asp-action="GrantAdminRole" asp-route-id="@item.AccountId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Are you sure you want to grant admin role to this account?');">
                                        <i class="bi bi-person-plus-fill"></i> Grant Admin
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function searchTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }
    </script>
}
else
{
    <div class="container py-5">
        <div class="alert alert-warning text-center" role="alert">
            You need to log in to view this page.
        </div>
    </div>
}
