@model IEnumerable<BookStore.DataModels.Account>

@{
    ViewData["Title"] = "Account List";
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h2 class="mb-0">Account List</h2>
                <div class="w-50">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search accounts..." onkeyup="searchTable()">
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Username</td>
                                    <td>@item.Email</td>
                                    <td>@item.Address</td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-outline-primary btn-sm" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-outline-info btn-sm" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.AccountId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this account?');" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                        <form asp-action="GrantAdminRole" asp-route-id="@item.AccountId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Are you sure you want to grant admin role to this account?');" title="Grant Admin">
                                                <i class="bi bi-person-plus-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function searchTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }
    </script>
}
else
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center" role="alert">
            <h4>Access Denied</h4>
            <p>You do not have permission to view this page. Please log in as an administrator.</p>
        </div>
    </div>
}