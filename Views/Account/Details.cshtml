@model BookStore.DataModels.Account

@{
    ViewData["Title"] = "Account Details";
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Account Details</h2>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-3">
                                <h6 class="mb-0">Username</h6>
                            </div>
                            <div class="col-sm-9 text-secondary">
                                @Model.Username
                            </div>
                        </div>
                        <hr>
                        <div class="row mb-3">
                            <div class="col-sm-3">
                                <h6 class="mb-0">Email</h6>
                            </div>
                            <div class="col-sm-9 text-secondary">
                                @Model.Email
                            </div>
                        </div>
                        <hr>
                        <div class="row mb-3">
                            <div class="col-sm-3">
                                <h6 class="mb-0">Address</h6>
                            </div>
                            <div class="col-sm-9 text-secondary">
                                @Model.Address
                            </div>
                        </div>
                        <hr>
                        <div class="row mb-3">
                            <div class="col-sm-3">
                                <h6 class="mb-0">Roles</h6>
                            </div>
                            <div class="col-sm-9 text-secondary">
                                @if (Model.Roles != null && Model.Roles.Any())
                                {
                                    foreach (var role in Model.Roles)
                                    {
                                        <span class="badge bg-info me-1">@role.RoleName</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No roles assigned.</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <a asp-action="List" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center" role="alert">
            <h4>Access Denied</h4>
            <p>You do not have permission to view this page. Please log in as an administrator.</p>
        </div>
    </div>
}