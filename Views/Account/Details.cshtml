@model BookStore.DataModels.Account

@{
    ViewData["Title"] = "Account Details";
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-primary text-white text-center rounded-top-4">
                            <h2 class="mb-0">Account Details</h2>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label text-muted">Username</label>
                                <div class="fw-semibold">@Model.Username</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Password</label>
                                <div class="text-danger">••••••••</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Email</label>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Address</label>
                                <div class="fw-semibold">@Model.Address</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Roles</label>
                                @if (Model.Roles != null && Model.Roles.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var role in Model.Roles)
                                        {
                                            <li class="badge bg-secondary me-1">@role.RoleName</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="text-muted">No roles assigned.</div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white text-center">
                            <a asp-action="List" class="btn btn-outline-secondary px-4">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <div class="container py-5">
        <div class="alert alert-warning text-center" role="alert">
            You need to log in as an admin to view this page.
        </div>
    </div>
}
