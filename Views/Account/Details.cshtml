@model BookStore.DataModels.Account

@{
    ViewData["Title"] = "Account Details";
}
@if(User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <section class="vh-100 d-flex align-items-center justify-content-center bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="card shadow-lg border-0 rounded-4">
                        <div class="card-header bg-dark text-white text-center rounded-top-4">
                            <h2 class="mb-0">Account Details</h2>
                        </div>
                        <div class="card-body p-5">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Username</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Username)</dd>

                                <dt class="col-sm-4 text-muted">Password</dt>
                                <dd class="col-sm-8 text-danger">••••••••</dd>

                                <dt class="col-sm-4 text-muted">Email</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                                <dt class="col-sm-4 text-muted">Address</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>
                                <dt class="col-sm-4 text-muted">Role</dt>
                                @foreach (var role in Model.Roles)
                                {
                                    <dd class="col-sm-8">@Html.DisplayFor(model => role.RoleName)</dd>
                                })
                            </dl>
                        </div>
                        <div class="card-footer bg-white text-center">
                            <a asp-action="List" class="btn btn-outline-secondary px-4">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <h1>You need to login!</h1>
}

