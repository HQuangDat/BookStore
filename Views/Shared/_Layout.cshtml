<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStore</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
    <style>
        #searchResult li {
            transition: background-color 0.2s ease;
            cursor: pointer;
        }

            #searchResult li:hover {
                background-color: #f8f9fa;
            }

            #searchResult li a {
                color: inherit;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px;
            }

                #searchResult li a:hover {
                    text-decoration: none;
                }

        #searchResult img {
            border-radius: 5px;
        }
    </style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-light" data-bs-theme="light">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">BookStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor03" aria-controls="navbarColor03" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor03">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                Home
                                <span class="visually-hidden">(current)</span>
                            </a>
                        </li>

                        @if(User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                        @if(User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Mangament</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Book" asp-action="List">List of Book</a>
                                    <a class="dropdown-item" asp-controller="Warehouse" asp-action="List">List of Warehouse</a>
                                    <a class="dropdown-item" asp-controller="Category" asp-action="List">List of Category</a>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="List">User management</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="#">Separated link</a>
                                </div>
                            </li>
                        }
                    </ul>

                    @* Search *@
                    <div class="d-flex justify-content-center flex-grow-1 position-relative">
                        <form class="d-flex w-50 position-relative">
                            <input id="searchInput" class="form-control me-2" type="search" placeholder="Search" autocomplete="off">
                            <button class="btn btn-secondary" type="submit">Search</button>
                        </form>
                        <ul id="searchResult" class="list-group position-absolute w-50" style="top: 100%; z-index: 1000;"></ul>
                    </div>

                    
                    @* Cart Icon *@
                    <a asp-controller="Cart" asp-action="Index" class="position-relative text-decoration-none">
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <img src="~/lib/bootstrap-icons/icons/cart.svg" alt="Cart" width="24" height="24">

                            <span id="countDisplay"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.75rem; display: none;">
                            </span>
                        </div>
                    </a>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BookStore
        </div>
    </footer>
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/SearchItem.js"></script>
    <script src="~/js/cartItemCount.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
