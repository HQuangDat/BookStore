@model IEnumerable<BookStore.DataModels.BookWarehouse>

@{
    ViewData["Title"] = "List Quantity";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold"><i class="bi bi-box-seam"></i> Warehouse Inventory</h2>
        <a asp-action="AddToWarehouse" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Entry
        </a>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Quantity</th>
                        <th>Book</th>
                        <th>Warehouse Location</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Quantity</td>
                            <td>@item.Book.BookName</td>
                            <td>@item.Warehouse.location</td>
                            <td class="text-center">
                                <a asp-action="EditQuantity" asp-route-Warehouseid="@item.Warehouse.WarehouseId" asp-route-Bookid="@item.Book.BookId" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

