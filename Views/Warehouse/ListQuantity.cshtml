@model IEnumerable<BookStore.DataModels.BookWarehouse>

@{
    ViewData["Title"] = "Warehouse Inventory";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Warehouse Inventory</h2>
            <a asp-action="AddToWarehouse" class="btn btn-light text-primary">
                <i class="bi bi-plus-circle-fill me-2"></i>Add New Entry
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th>Warehouse</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Book.BookName</td>
                                <td>@item.Warehouse.location</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-center">
                                    <a asp-action="EditQuantity" asp-route-Warehouseid="@item.Warehouse.WarehouseId" asp-route-Bookid="@item.Book.BookId" class="btn btn-outline-primary btn-sm" title="Edit Quantity">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>