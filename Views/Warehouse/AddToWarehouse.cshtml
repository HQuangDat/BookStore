@model BookStore.DataModels.BookWarehouse

@{
    ViewData["Title"] = "Add Book to Warehouse";
}

@if (User.IsInRole("Admin"))
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Add Book to Warehouse</h2>
                    </div>
                    <div class="card-body">
                        <form asp-action="AddToWarehouse">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="BookId" class="form-label">Book</label>
                                <select asp-for="BookId" class="form-select" asp-items="ViewBag.AvailableBooks"></select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="WarehouseId" class="form-label">Warehouse</label>
                                <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.AvailableWarehouses"></select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label"></label>
                                <input asp-for="Quantity" class="form-control" type="number" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a asp-action="List" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-primary">Add to Warehouse</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center" role="alert">
            <h4>Access Denied</h4>
            <p>You do not have permission to view this page. Please log in as an administrator.</p>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}