@model IEnumerable<BookStore.DataModels.Warehouse>

@{
    ViewData["Title"] = "List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Warehouse Management</h2>
        <a asp-action="Add" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add New Warehouse
        </a>
    </div>

    <!-- Optional: Search Bar -->
    <div class="mb-3">
        <input type="text" class="form-control" id="searchInput" placeholder="Search warehouses..." onkeyup="searchTable()">
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Location</th>
                    <th>Remaining Stock</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.location</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.WarehouseId" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.WarehouseId" class="btn btn-info btn-sm text-white">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.WarehouseId" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this warehouse?');">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function searchTable() {
        let input = document.getElementById("searchInput").value.toLowerCase();
        let rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    }
</script>

