@model BookStore.DataModels.Warehouse

@{
    ViewData["Title"] = "Edit";
}

<h1 class="mb-4">Edit Warehouse</h1>

<div class="card shadow-sm p-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="WarehouseId" />

                <div class="mb-3">
                    <label asp-for="location" class="form-label fw-bold"></label>
                    <input asp-for="location" class="form-control" placeholder="Enter warehouse location" />
                    <span asp-validation-for="location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Remaining" class="form-label fw-bold"></label>
                    <input asp-for="Remaining" type="number" class="form-control" placeholder="Enter remaining stock" />
                    <span asp-validation-for="Remaining" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="List" class="btn btn-outline-secondary">Back to List</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
