@model BookStore.DataModels.BookWarehouse

@{
    ViewData["Title"] = "Edit Quantity";
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <section class="vh-100 d-flex align-items-center justify-content-center bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card shadow-lg rounded-4">
                        <div class="card-body p-4">
                            <h3 class="text-center mb-4 text-primary fw-bold">Edit Book Quantity</h3>

                            <form asp-action="EditQuantity">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                @Html.AntiForgeryToken()

                                <input type="hidden" asp-for="BookId" />
                                <input type="hidden" asp-for="WarehouseId" />

                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                                    <input asp-for="Quantity" class="form-control" placeholder="Enter new quantity" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success fw-bold">
                                        <i class="bi bi-save me-1"></i> Save Changes
                                    </button>
                                </div>
                            </form>

                            <div class="mt-4 text-center">
                                <a asp-action="List" class="text-decoration-none text-muted">
                                    <i class="bi bi-arrow-left-circle"></i> Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <h1>You are not supposed to be here!</h1>
    <div class="mt-4 text-center">
        <a asp-action="List" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}